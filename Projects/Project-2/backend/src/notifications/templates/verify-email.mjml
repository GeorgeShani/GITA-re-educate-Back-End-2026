<mjml>
  <mj-head>
    <mj-title>Verify your email — 3legant Golf</mj-title>
    <!-- Google Fonts, not self-hosted — SCOPE.md A1's "self-host via npm
         packages" rule is a frontend-build-tooling constraint (content-
         hashed filenames, no <link rel=preload>); it doesn't extend to
         email, where a webfont can only ever be a best-effort <mj-font>
         link. Legacy Outlook ignores it and falls back to the stack below. -->
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <mj-attributes>
      <!-- body-2 (A2) -->
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#343839" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F3F5F7">
    <mj-section padding="40px 0 24px 0">
      <mj-column>
        <!-- headline-7 (A2): Poppins 500 20/28 -->
        <mj-text
          align="center"
          font-family="Poppins, Helvetica, Arial, sans-serif"
          font-size="20px"
          font-weight="500"
          line-height="28px"
          color="#141718"
        >
          3legant Golf
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FEFEFE" border-radius="8px" padding="40px 32px">
      <mj-column>
        <!-- headline-6 (A2): Poppins 500 28/34, tracking -0.6 -->
        <mj-text
          font-family="Poppins, Helvetica, Arial, sans-serif"
          font-size="28px"
          font-weight="500"
          line-height="34px"
          letter-spacing="-0.6px"
          color="#141718"
          padding-bottom="16px"
        >
          Verify your email
        </mj-text>
        <mj-text padding-bottom="32px">
          Hi {{firstName}}, thanks for creating an account. Confirm this is your email address to finish setting up your account.
        </mj-text>
        <!-- Button (primary), A5: h40, 6px 40px, radius 8, fill neutral-07, button-s type -->
        <mj-button
          background-color="#141718"
          color="#FEFEFE"
          border-radius="8px"
          font-family="Inter, Helvetica, Arial, sans-serif"
          font-size="16px"
          font-weight="500"
          line-height="28px"
          letter-spacing="-0.4px"
          inner-padding="6px 40px"
          href="{{{verificationUrl}}}"
        >
          Verify email
        </mj-button>
        <!-- caption-1 (A2): Inter 400 14/22 -->
        <mj-text font-size="14px" line-height="22px" color="#6C7275" padding-top="32px">
          Or paste this link into your browser:<br />
          <a href="{{{verificationUrl}}}" style="color:#377DFF">{{{verificationUrl}}}</a>
        </mj-text>
        <mj-text font-size="14px" line-height="22px" color="#6C7275" padding-top="16px">
          If you didn't create this account, you can safely ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 0">
      <mj-column>
        <mj-text align="center" font-size="14px" line-height="22px" color="#6C7275">
          3legant Golf — 123 Fairway Ave, Suite 400
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
