<mjml>
  <mj-head>
    <mj-title>Reset your password — 3legant Golf</mj-title>
    <mj-preview>Use this link to set a new password. It expires in 1 hour.</mj-preview>
    <!-- Webfonts are best-effort in email — legacy Outlook ignores the
         link and falls back to the stack. Families and hex values track
         frontend/src/styles/_tokens.scss (Poppins for headings, Inter
         for body; the neutral ramp + the one green accent). -->
    <mj-font name="Poppins" href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" />
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="26px" color="#343839" />
      <mj-section padding="0" />
      <mj-class name="h1" font-family="Poppins, Helvetica, Arial, sans-serif" font-size="28px" font-weight="500" line-height="34px" letter-spacing="-0.6px" color="#141718" />
      <mj-class name="muted" font-size="14px" line-height="22px" color="#6C7275" />
    </mj-attributes>
    <mj-style>
      a { color: #3170E5; }
      .wordmark-dot { color: #38CB89; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#F3F5F7">
    <!-- Header -->
    <mj-section padding="40px 0 20px 0">
      <mj-column>
        <mj-text align="center" font-family="Poppins, Helvetica, Arial, sans-serif" font-size="22px" font-weight="600" line-height="28px" letter-spacing="-0.5px" color="#141718">
          3legant<span class="wordmark-dot">.</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card -->
    <mj-section background-color="#FEFEFE" border-radius="8px" padding="40px 32px 36px 32px" border="1px solid #E8ECEF">
      <mj-column>
        <mj-text mj-class="h1" padding-bottom="8px">Reset your password</mj-text>
        <mj-text padding-bottom="28px">
          Hi {{firstName}} — we received a request to reset your password. This link expires in 1 hour.
        </mj-text>

        <mj-button
          align="left"
          background-color="#141718"
          color="#FEFEFE"
          border-radius="8px"
          font-family="Inter, Helvetica, Arial, sans-serif"
          font-size="16px"
          font-weight="500"
          line-height="26px"
          letter-spacing="-0.2px"
          inner-padding="10px 28px"
          padding="0"
          href="{{{resetUrl}}}"
        >
          Reset password
        </mj-button>

        <mj-text mj-class="muted" padding-top="28px">
          Or paste this link into your browser:<br />
          <a href="{{{resetUrl}}}">{{{resetUrl}}}</a>
        </mj-text>

        <mj-divider border-width="1px" border-color="#E8ECEF" padding="24px 0" />

        <mj-text mj-class="muted" padding="0">
          If you didn't request this, you can safely ignore this email — your password won't change.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section padding="28px 0 40px 0">
      <mj-column>
        <mj-text align="center" font-family="Poppins, Helvetica, Arial, sans-serif" font-size="15px" font-weight="600" color="#141718" padding-bottom="10px">
          3legant<span class="wordmark-dot">.</span>
        </mj-text>
        <mj-text align="center" mj-class="muted" padding-bottom="12px">
          <a href="{{appUrl}}/shop" style="color:#6C7275;text-decoration:none">Shop</a>
          &nbsp;&middot;&nbsp;
          <a href="{{appUrl}}/blog" style="color:#6C7275;text-decoration:none">Journal</a>
          &nbsp;&middot;&nbsp;
          <a href="{{appUrl}}/contact" style="color:#6C7275;text-decoration:none">Contact</a>
        </mj-text>
        <mj-text align="center" font-size="12px" line-height="20px" color="#6C7275">
          You're receiving this because a password reset was requested for your 3legant Golf account.<br />
          3legant Golf, 123 Fairway Ave, Suite 400 &nbsp;&middot;&nbsp; &copy; {{year}} 3legant Golf
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
