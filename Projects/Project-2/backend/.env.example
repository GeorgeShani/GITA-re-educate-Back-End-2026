NODE_ENV=development        # development | test | production
MONGODB_URI=               # Atlas SRV string, retryWrites=true&w=majority
REDIS_URL=
ROLE=all                    # api | worker | all

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

PAYMENT_PROVIDER=mock       # stripe | mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=   # optional: named in the signed upload params so Cloudinary enforces format/size limits — see docs/ENV_SECRETS_GUIDE.md §5

MAIL_PROVIDER=console        # console | resend | noop
RESEND_API_KEY=
MAIL_FROM=orders@mail.<domain>
MAIL_FROM_NAME=3legant Golf
MAIL_REPLY_TO=
MAIL_WEBHOOK_SECRET=         # Resend webhook signature
MAIL_DEV_REDIRECT=           # non-prod: every recipient rewritten to this
MAIL_DEV_ALLOWLIST=          # comma-separated addresses exempt from the redirect

GEMINI_API_KEY=             # AI shopping assistant (S12) — unset means the assistant returns a clear "not configured" error instead of failing boot
GEMINI_MODEL=gemini-3.8-flash

PEXELS_API_KEY=              # scripts/seed-catalog.ts only, not read by the running app

SEARCH_PROVIDER=mongo       # 'mongo' (default) uses a MongoDB $text index — works anywhere. 'atlas' uses the Atlas Search "products_search" index, which must be provisioned separately.

REVIEWS_AUTO_APPROVE=true    # dev convenience — set false to see the admin moderation queue (/admin/reviews) actually do something

SENTRY_DSN=                  # error tracking (S13) — unset means Sentry never initializes
BULL_BOARD_USERNAME=         # Basic Auth for /admin/queues (S13) — unset means it never mounts
BULL_BOARD_PASSWORD=

PORT=4000
CORS_ORIGIN=http://localhost:4200
APP_URL=
