NODE_ENV=development        # development | test | production
MONGODB_URI=               # Atlas SRV string, retryWrites=true&w=majority
REDIS_URL=
ROLE=all                    # api | worker | all

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=

PAYMENT_PROVIDER=mock       # stripe | mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=   # unused by current code (signing covers timestamp+folder only) — leave blank, see docs/ENV_SECRETS_GUIDE.md §5
CLOUDINARY_WEBHOOK_SECRET=  # unused by current code — no Cloudinary-side webhook is registered yet, see docs/ENV_SECRETS_GUIDE.md §5

MAIL_PROVIDER=console        # console | resend | noop
RESEND_API_KEY=
MAIL_FROM=orders@mail.<domain>
MAIL_FROM_NAME=3legant Golf
MAIL_REPLY_TO=
MAIL_WEBHOOK_SECRET=         # Resend webhook signature
MAIL_DEV_REDIRECT=           # non-prod: every recipient rewritten to this
MAIL_DEV_ALLOWLIST=          # comma-separated addresses exempt from the redirect
MAIL_ADMIN_RECIPIENTS=       # who gets the Ops-category mail

GEMINI_API_KEY=             # not read by any code yet — reserved for S12, unbuilt

PEXELS_API_KEY=              # scripts/seed-catalog.ts only, not read by the running app

REVIEWS_AUTO_APPROVE=true    # dev only — no admin moderation UI exists (Phase 6, out of scope)

PORT=3000
CORS_ORIGIN=http://localhost:4200
APP_URL=
