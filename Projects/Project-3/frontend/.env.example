# Copy to .env.

NEXT_PUBLIC_APP_NAME=Gridline

# Server-side base URL for reaching the API directly — container-to-container
# in Docker (http://api:4000), or localhost:4000 for local dev without
# Docker. Never used by the browser: browser calls go through the same-origin
# /api/* proxy (Caddy in Docker, next.config.ts rewrites() otherwise).
API_ORIGIN=http://api:4000
# Where the header and footer "API reference" link points. The reference is served by the API (Scalar), so behind Caddy the
# default same-origin /reference is right; set this only for local development, e.g. http://localhost:4000/reference.
# NEXT_PUBLIC_API_REFERENCE_URL=
