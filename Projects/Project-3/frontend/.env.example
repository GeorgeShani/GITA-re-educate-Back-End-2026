# Copy to .env.

NEXT_PUBLIC_APP_NAME=Gridline

# Server-side base URL for reaching the API directly — container-to-container
# in Docker (http://api:4000), or localhost:4000 for local dev without
# Docker. Never used by the browser: browser code calls this site's own /session/api/* (which attaches the session's token and
# forwards here), never the API directly. The API itself has no /api prefix: it is /health, /files, … on port 4000. Only the
# Caddy proxy adds a public /api/ in front of it (and strips it again), so /api/health works behind Caddy and not on :4000.
API_ORIGIN=http://api:4000
# Where the header and footer "API reference" link points. The reference is served by the API (Scalar), so behind Caddy the
# default same-origin /reference is right; set this only for local development, e.g. http://localhost:4000/reference.
# NEXT_PUBLIC_API_REFERENCE_URL=

# Where the browser opens its live (Socket.IO) connection. Behind Caddy it is the site's own address, so leave it unset.
# In local development the API is a different port, so point it there: http://localhost:4000
# NEXT_PUBLIC_REALTIME_URL=
