      "field-deep": { "$value": "oklch(0.27 0.04 234)" },
      "on-field": { "$value": "oklch(0.96 0.01 230)" },
      "on-field-muted": { "$value": "oklch(0.83 0.025 230)" },
      "folder": { "$value": "oklch(0.78 0.075 82)" },
      "folder-soft": { "$value": "oklch(0.29 0.03 75)" },
      "on-folder": { "$value": "oklch(0.22 0.035 60)" },
      "action": { "$value": "oklch(0.74 0.12 252)" },
      "action-hover": { "$value": "oklch(0.8 0.1 252)" },
      "on-action": { "$value": "oklch(0.18 0.03 255)" },
      "focus": { "$value": "oklch(0.76 0.13 252)" },
      "pass": { "$value": "oklch(0.75 0.13 155)" },
      "pass-soft": { "$value": "oklch(0.27 0.04 155)" },
      "hold": { "$value": "oklch(0.72 0.16 28)" },
      "hold-soft": { "$value": "oklch(0.28 0.05 25)" },
      "caution": { "$value": "oklch(0.77 0.12 62)" },
      "caution-soft": { "$value": "oklch(0.28 0.04 65)" },
      "live": { "$value": "oklch(0.8 0.15 78)" },
      "live-soft": { "$value": "oklch(0.3 0.05 78)" },
      "live-ink": { "$value": "oklch(0.86 0.12 80)" }
    }
  },
  "contrast": {
    "$description": "Pairs the build verifies in BOTH themes (WCAG 2.2 AA). text = 4.5, large = 3, ui = 3 (non-text).",
    "pairs": [
      ["text", "canvas", "text"], ["text", "surface", "text"], ["text", "sunken", "text"],
      ["text-muted", "canvas", "text"], ["text-muted", "surface", "text"], ["text-muted", "sunken", "text"],
      ["text-subtle", "canvas", "text"], ["text-subtle", "surface", "text"],
      ["on-field", "field", "text"], ["on-field-muted", "field", "text"], ["on-field", "field-deep", "text"],
      ["on-folder", "folder", "text"], ["text", "folder-soft", "text"],
      ["on-action", "action", "text"], ["on-action", "action-hover", "text"], ["action", "canvas", "text"], ["action", "surface", "text"],
      ["pass", "canvas", "text"], ["pass", "pass-soft", "text"], ["pass", "surface", "text"],
      ["hold", "canvas", "text"], ["hold", "hold-soft", "text"], ["hold", "surface", "text"],
      ["caution", "canvas", "text"], ["caution", "caution-soft", "text"], ["caution", "surface", "text"],
      ["live-ink", "live-soft", "text"], ["live-ink", "surface", "text"],
      ["focus", "canvas", "ui"], ["focus", "surface", "ui"], ["line-strong", "surface", "ui"]
    ]
  },
  "font": {
    "sans": { "$value": "var(--font-archivo), ui-sans-serif, system-ui, sans-serif", "$description": "Archivo: UI and body at width 100, display expanded (width 112), stamps condensed (width 72)." },
    "mono": { "$value": "var(--font-martian), ui-monospace, monospace", "$description": "Martian Mono: accession numbers, IDs, code. Data only, never decoration." }
  },
  "width": {
    "stamp": { "$value": "72" },
    "text": { "$value": "100" },
    "display": { "$value": "112" }
  },
  "text": {
    "2xs": { "$value": "0.6875rem", "leading": "1rem" },
    "xs": { "$value": "0.75rem", "leading": "1.125rem" },
    "sm": { "$value": "0.8125rem", "leading": "1.25rem" },
    "base": { "$value": "0.875rem", "leading": "1.375rem" },
    "md": { "$value": "1rem", "leading": "1.5rem" },
    "lg": { "$value": "1.125rem", "leading": "1.625rem" },
    "xl": { "$value": "1.375rem", "leading": "1.875rem" },
    "2xl": { "$value": "1.75rem", "leading": "2.25rem" },
    "3xl": { "$value": "2.25rem", "leading": "2.625rem" },
    "4xl": { "$value": "3rem", "leading": "3.25rem" },
    "5xl": { "$value": "4.25rem", "leading": "4.375rem" }
  },
  "radius": {
    "xs": { "$value": "2px" },
    "sm": { "$value": "3px" },
    "md": { "$value": "4px" },
    "lg": { "$value": "6px" }
  },
  "motion": {
    "fast": { "$value": "120ms" },
    "base": { "$value": "180ms" },
    "slow": { "$value": "320ms" },
    "ease-out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "ease-in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
  },
  "shadow": {
    "overlay": {
      "light": "0 12px 32px -8px oklch(0.22 0.03 240 / 0.28), 0 2px 6px oklch(0.22 0.03 240 / 0.12)",
      "dark": "0 12px 32px -8px oklch(0.05 0.01 240 / 0.6), 0 2px 6px oklch(0.05 0.01 240 / 0.4)",
      "$description": "The ONLY shadow: overlays that float above the page (menus, dialogs, popovers). Everything else is a hairline."
    }
  }
}
