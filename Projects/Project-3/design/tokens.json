      "tab-grass": { "$value": "oklch(0.62 0.16 145)" },
      "tab-teal": { "$value": "oklch(0.62 0.11 195)" },
      "tab-blue": { "$value": "oklch(0.5 0.18 262)" },
      "tab-sienna": { "$value": "oklch(0.47 0.1 48)" },
      "on-tab-light": { "$value": "oklch(0.2 0.012 80)" },
      "on-tab-dark": { "$value": "oklch(0.98 0.01 92)" },
