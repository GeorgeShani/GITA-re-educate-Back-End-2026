      "text": { "$value": "oklch(0.24 0.03 255)", "$description": "Blue-black register ink." },
      "text-muted": { "$value": "oklch(0.44 0.03 245)" },
      "text-subtle": { "$value": "oklch(0.52 0.028 240)", "$description": "Smallest legible ink: timestamps, hints." },
      "field": { "$value": "oklch(0.42 0.05 232)", "$description": "Archival box board. Owns whole regions on Persuade surfaces." },
      "field-deep": { "$value": "oklch(0.34 0.045 234)" },
      "on-field": { "$value": "oklch(0.97 0.01 230)" },
      "on-field-muted": { "$value": "oklch(0.84 0.025 230)" },
      "folder": { "$value": "oklch(0.84 0.08 82)", "$description": "Manila folder stock: the file itself, the catalogue card." },
      "folder-soft": { "$value": "oklch(0.935 0.04 84)" },
      "on-folder": { "$value": "oklch(0.28 0.045 60)" },
      "action": { "$value": "oklch(0.45 0.14 258)", "$description": "Registrar's ink: buttons, links, the active rail entry." },
      "action-hover": { "$value": "oklch(0.39 0.14 258)" },
      "on-action": { "$value": "oklch(0.98 0.005 250)" },
      "focus": { "$value": "oklch(0.55 0.17 258)" },
      "pass": { "$value": "oklch(0.49 0.12 155)", "$description": "Stamp green: passed, within quota, succeeded." },
      "pass-soft": { "$value": "oklch(0.95 0.035 155)" },
      "hold": { "$value": "oklch(0.53 0.19 29)", "$description": "Stamp vermilion: failed, over limit, restricted, destructive." },
      "hold-soft": { "$value": "oklch(0.955 0.028 25)" },
      "caution": { "$value": "oklch(0.52 0.12 55)", "$description": "Umber stamp: approaching a limit, warning-severity rules." },
      "caution-soft": { "$value": "oklch(0.955 0.035 70)" },
      "live": { "$value": "oklch(0.78 0.16 76)", "$description": "Sodium amber. RESERVED for 'being profiled right now'. Nothing else may use it." },
