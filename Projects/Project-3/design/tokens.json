{
  "$description": "Gridline design tokens — THE single source. The 'Tabbed Binder' world: a boxed-software reference manual. Milk-cream pages, print ink, full-strength section hues, chrome-yellow actions, hairline-outlined leaves. Violet is deliberately held out of the tab wheel. Edit here, then run `node design/build-tokens.mjs`; never edit a generated file.",
  "color": {
    "$type": "color",
    "light": {
      "canvas": { "$value": "oklch(0.965 0.022 92)", "$description": "The page: milk-cream stock." },
      "surface": { "$value": "oklch(0.988 0.011 92)", "$description": "A leaf laid on the page: inputs, panels, table bodies." },
      "sunken": { "$value": "oklch(0.94 0.028 90)", "$description": "Wells, table headers, code." },
      "line": { "$value": "oklch(0.86 0.032 88)", "$description": "Hairline rules and card outlines." },
      "line-strong": { "$value": "oklch(0.58 0.035 80)", "$description": "Input borders, emphasised rules. Held at 3:1 on surface (WCAG 1.4.11)." },
      "text": { "$value": "oklch(0.2 0.012 80)", "$description": "Print ink." },
      "text-muted": { "$value": "oklch(0.42 0.02 80)" },
      "text-subtle": { "$value": "oklch(0.5 0.024 80)", "$description": "Smallest legible ink: timestamps, hints." },
      "cover": { "$value": "oklch(0.2 0.012 80)", "$description": "The back cover and dark bands: solid print ink." },
      "on-cover": { "$value": "oklch(0.97 0.014 92)" },
      "on-cover-muted": { "$value": "oklch(0.82 0.02 88)" },
      "tag": { "$value": "oklch(0.86 0.17 92)", "$description": "Chrome yellow: primary actions, the logo cell." },
      "tag-hover": { "$value": "oklch(0.8 0.17 90)" },
      "tag-soft": { "$value": "oklch(0.95 0.07 95)" },
      "on-tag": { "$value": "oklch(0.2 0.012 80)" },
      "tab-orange": { "$value": "oklch(0.68 0.19 48)", "$description": "Oxide orange." },
      "tab-grass": { "$value": "oklch(0.62 0.16 145)", "$description": "Grass." },
      "tab-teal": { "$value": "oklch(0.62 0.11 195)", "$description": "Teal." },
      "tab-blue": { "$value": "oklch(0.5 0.18 262)", "$description": "Ultramarine." },
      "tab-sienna": { "$value": "oklch(0.47 0.1 48)", "$description": "Sienna." },
      "on-tab-light": { "$value": "oklch(0.2 0.012 80)", "$description": "Ink lettering on the light hues (yellow, orange, grass, teal)." },
      "on-tab-dark": { "$value": "oklch(0.98 0.01 92)", "$description": "Milk lettering on the deep hues (ultramarine, sienna)." },
      "action": { "$value": "oklch(0.2 0.012 80)", "$description": "Ink: links, focus, the pressed secondary button." },
      "action-hover": { "$value": "oklch(0.34 0.014 80)" },
      "on-action": { "$value": "oklch(0.97 0.014 92)" },
      "focus": { "$value": "oklch(0.2 0.012 80)" },
      "pass": { "$value": "oklch(0.47 0.12 152)", "$description": "PASS: passed, within quota, succeeded, paid." },
      "pass-soft": { "$value": "oklch(0.94 0.045 150)" },
      "hold": { "$value": "oklch(0.5 0.19 27)", "$description": "Vermilion errata slip: failed, over limit, restricted, overdue, destructive. Never a tab hue." },
      "hold-soft": { "$value": "oklch(0.955 0.03 25)" },
      "caution": { "$value": "oklch(0.5 0.11 55)", "$description": "Umber: approaching a limit, warning-severity rules." },
      "caution-soft": { "$value": "oklch(0.95 0.045 65)" },
      "live": { "$value": "oklch(0.86 0.17 92)", "$description": "Chrome yellow on a product screen also means: being inspected right now." },
      "live-soft": { "$value": "oklch(0.95 0.07 95)" },
      "live-ink": { "$value": "oklch(0.42 0.09 80)" }
    },
    "dark": {
