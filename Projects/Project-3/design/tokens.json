{
  "$description": "Gridline design tokens — THE single source. The 'Inspected on Arrival' world: a receiving dock. Label-stock paper, black ink, kraft crate board, hi-vis inspection-tag yellow, PASS/HOLD stamps. Edit here, then run `node design/build-tokens.mjs`; never edit a generated file.",
  "color": {
    "$type": "color",
    "light": {
      "canvas": { "$value": "oklch(0.965 0.012 88)", "$description": "Page ground: label stock, never white." },
      "surface": { "$value": "oklch(0.99 0.006 88)", "$description": "Panels, table bodies, inputs: a fresh label." },
      "sunken": { "$value": "oklch(0.93 0.016 86)", "$description": "Wells, table headers, code." },
      "line": { "$value": "oklch(0.86 0.02 85)", "$description": "Hairline rules. Replace shadows." },
      "line-strong": { "$value": "oklch(0.58 0.03 80)", "$description": "Input borders, emphasised rules. Held at 3:1 on surface (WCAG 1.4.11)." },
      "text": { "$value": "oklch(0.2 0.01 90)", "$description": "Stencil ink." },
      "text-muted": { "$value": "oklch(0.42 0.015 85)" },
      "text-subtle": { "$value": "oklch(0.5 0.018 85)", "$description": "Smallest legible ink: timestamps, hints." },
      "field": { "$value": "oklch(0.7 0.075 72)", "$description": "Kraft crate board. Owns whole regions on the marketing site." },
      "field-deep": { "$value": "oklch(0.62 0.08 68)" },
      "on-field": { "$value": "oklch(0.2 0.01 90)" },
      "on-field-muted": { "$value": "oklch(0.3 0.03 70)" },
      "tag": { "$value": "oklch(0.86 0.17 92)", "$description": "Hi-vis inspection tag. The brand yellow: the logo cell, the tag on the marketing hero." },
      "tag-soft": { "$value": "oklch(0.95 0.07 95)" },
      "on-tag": { "$value": "oklch(0.2 0.01 90)" },
      "action": { "$value": "oklch(0.22 0.01 90)", "$description": "Ink fills every primary action: the one solid button on a screen." },
      "action-hover": { "$value": "oklch(0.34 0.012 90)" },
      "on-action": { "$value": "oklch(0.97 0.01 88)" },
      "focus": { "$value": "oklch(0.22 0.01 90)" },
      "pass": { "$value": "oklch(0.47 0.12 152)", "$description": "PASS stamp: passed, within quota, succeeded, paid." },
      "pass-soft": { "$value": "oklch(0.94 0.04 150)" },
      "hold": { "$value": "oklch(0.5 0.19 27)", "$description": "HOLD stamp: failed, over limit, restricted, overdue, destructive." },
      "hold-soft": { "$value": "oklch(0.955 0.03 25)" },
      "caution": { "$value": "oklch(0.5 0.11 55)", "$description": "Umber: approaching a limit, warning-severity rules." },
      "caution-soft": { "$value": "oklch(0.95 0.04 65)" },
      "live": { "$value": "oklch(0.86 0.17 92)", "$description": "Hi-vis yellow on a product screen means ONE thing: being inspected right now." },
      "live-soft": { "$value": "oklch(0.95 0.07 95)" },
      "live-ink": { "$value": "oklch(0.42 0.09 80)" }
    },
    "dark": {
      "canvas": { "$value": "oklch(0.17 0.008 90)", "$description": "The dock at night: warm black, not blue-black." },
      "surface": { "$value": "oklch(0.21 0.01 90)" },
      "sunken": { "$value": "oklch(0.145 0.008 90)" },
      "line": { "$value": "oklch(0.3 0.012 88)" },
      "line-strong": { "$value": "oklch(0.52 0.02 85)" },
      "text": { "$value": "oklch(0.95 0.012 88)" },
      "text-muted": { "$value": "oklch(0.78 0.015 86)" },
      "text-subtle": { "$value": "oklch(0.68 0.016 85)" },
      "field": { "$value": "oklch(0.3 0.03 70)", "$description": "Crate board in shadow." },
      "field-deep": { "$value": "oklch(0.25 0.025 70)" },
      "on-field": { "$value": "oklch(0.95 0.012 88)" },
      "on-field-muted": { "$value": "oklch(0.82 0.03 75)" },
      "tag": { "$value": "oklch(0.86 0.17 92)" },
      "tag-soft": { "$value": "oklch(0.3 0.06 92)" },
      "on-tag": { "$value": "oklch(0.2 0.01 90)" },
      "action": { "$value": "oklch(0.95 0.012 88)" },
      "action-hover": { "$value": "oklch(0.86 0.02 88)" },
      "on-action": { "$value": "oklch(0.2 0.01 90)" },
      "focus": { "$value": "oklch(0.86 0.17 92)" },
      "pass": { "$value": "oklch(0.76 0.14 152)" },
      "pass-soft": { "$value": "oklch(0.26 0.045 152)" },
      "hold": { "$value": "oklch(0.72 0.17 27)" },
      "hold-soft": { "$value": "oklch(0.27 0.05 25)" },
      "caution": { "$value": "oklch(0.78 0.12 60)" },
      "caution-soft": { "$value": "oklch(0.28 0.04 62)" },
      "live": { "$value": "oklch(0.86 0.17 92)" },
      "live-soft": { "$value": "oklch(0.3 0.06 90)" },
      "live-ink": { "$value": "oklch(0.9 0.12 92)" }
    }
  },
  "contrast": {
    "$description": "Pairs the build verifies in BOTH themes (WCAG 2.2 AA). text = 4.5, large = 3, ui = 3 (non-text).",
    "pairs": [
      ["text", "canvas", "text"], ["text", "surface", "text"], ["text", "sunken", "text"],
      ["text-muted", "canvas", "text"], ["text-muted", "surface", "text"], ["text-muted", "sunken", "text"],
      ["text-subtle", "canvas", "text"], ["text-subtle", "surface", "text"],
      ["on-field", "field", "text"], ["on-field-muted", "field", "text"], ["on-field", "field-deep", "text"],
      ["on-tag", "tag", "text"], ["text", "tag-soft", "text"],
      ["on-action", "action", "text"], ["on-action", "action-hover", "text"], ["action", "canvas", "text"], ["action", "surface", "text"],
      ["pass", "canvas", "text"], ["pass", "pass-soft", "text"], ["pass", "surface", "text"],
      ["hold", "canvas", "text"], ["hold", "hold-soft", "text"], ["hold", "surface", "text"],
      ["caution", "canvas", "text"], ["caution", "caution-soft", "text"], ["caution", "surface", "text"],
      ["live-ink", "live-soft", "text"], ["live-ink", "surface", "text"], ["on-tag", "live", "text"],
      ["focus", "canvas", "ui"], ["focus", "surface", "ui"], ["focus", "field", "ui"], ["line-strong", "surface", "ui"]
    ]
  },
  "font": {
    "sans": { "$value": "var(--font-archivo), ui-sans-serif, system-ui, sans-serif", "$description": "Archivo: UI and body at width 100, display expanded (width 112, stencil-heavy), stamps condensed (width 72)." },
    "mono": { "$value": "var(--font-martian), ui-monospace, monospace", "$description": "Martian Mono: accession numbers, barcodes, IDs, code. Data only, never decoration." }
  },
  "width": {
    "stamp": { "$value": "72" },
    "text": { "$value": "100" },
    "display": { "$value": "112" }
  },
  "text": {
    "2xs": { "$value": "0.6875rem", "leading": "1rem" },
    "xs": { "$value": "0.75rem", "leading": "1.125rem" },
    "sm": { "$value": "0.8125rem", "leading": "1.25rem" },
    "base": { "$value": "0.875rem", "leading": "1.375rem" },
    "md": { "$value": "1rem", "leading": "1.5rem" },
    "lg": { "$value": "1.125rem", "leading": "1.625rem" },
    "xl": { "$value": "1.375rem", "leading": "1.875rem" },
    "2xl": { "$value": "1.75rem", "leading": "2.25rem" },
    "3xl": { "$value": "2.25rem", "leading": "2.625rem" },
    "4xl": { "$value": "3rem", "leading": "3.25rem" },
    "5xl": { "$value": "4.25rem", "leading": "4.375rem" }
  },
  "radius": {
    "xs": { "$value": "2px" },
    "sm": { "$value": "3px" },
    "md": { "$value": "4px" },
    "lg": { "$value": "6px" }
  },
  "motion": {
    "fast": { "$value": "120ms" },
    "base": { "$value": "180ms" },
    "slow": { "$value": "320ms" },
    "ease-out": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "ease-in-out": { "$value": "cubic-bezier(0.65, 0, 0.35, 1)" }
  },
  "shadow": {
    "overlay": {
      "light": "0 12px 32px -8px oklch(0.2 0.02 80 / 0.3), 0 2px 6px oklch(0.2 0.02 80 / 0.14)",
      "dark": "0 12px 32px -8px oklch(0.04 0.005 90 / 0.65), 0 2px 6px oklch(0.04 0.005 90 / 0.45)",
      "$description": "The ONLY shadow: overlays that float above the page (menus, dialogs, popovers). Everything else is a hairline."
    }
  }
}
