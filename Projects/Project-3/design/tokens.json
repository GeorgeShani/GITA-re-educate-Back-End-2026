{
  "$description": "Gridline design tokens — THE single source. The Accession Register world: blue-slate archival box board, manila folder stock, blue-black register ink, rubber-stamp inks. Edit here, then run `node design/build-tokens.mjs`; never edit a generated file.",
  "color": {
    "$type": "color",
    "light": {
      "canvas": { "$value": "oklch(0.975 0.006 230)", "$description": "Page ground: a pale wash of box board, never white." },
      "surface": { "$value": "oklch(0.995 0.003 230)", "$description": "Panels, table bodies, inputs." },
      "sunken": { "$value": "oklch(0.95 0.01 230)", "$description": "Wells, table headers, code." },
      "line": { "$value": "oklch(0.88 0.015 232)", "$description": "Hairline rules: the register's ruling. Replaces shadows." },
