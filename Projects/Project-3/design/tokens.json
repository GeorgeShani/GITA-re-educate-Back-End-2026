      "surface": { "$value": "oklch(0.235 0.014 85)" },
      "sunken": { "$value": "oklch(0.16 0.01 85)" },
      "line": { "$value": "oklch(0.32 0.016 85)" },
      "line-strong": { "$value": "oklch(0.54 0.022 85)" },
      "text": { "$value": "oklch(0.95 0.014 90)" },
      "text-muted": { "$value": "oklch(0.79 0.018 88)" },
      "text-subtle": { "$value": "oklch(0.69 0.02 86)" },
      "cover": { "$value": "oklch(0.12 0.008 85)" },
      "on-cover": { "$value": "oklch(0.95 0.014 90)" },
      "on-cover-muted": { "$value": "oklch(0.79 0.018 88)" },
      "tag": { "$value": "oklch(0.86 0.17 92)" },
