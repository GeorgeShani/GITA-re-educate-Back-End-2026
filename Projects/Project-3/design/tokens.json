      "live-ink": { "$value": "oklch(0.45 0.1 62)" }
    },
    "dark": {
      "canvas": { "$value": "oklch(0.19 0.02 240)", "$description": "The stacks at night: box-board slate, not black." },
      "surface": { "$value": "oklch(0.225 0.022 240)" },
      "sunken": { "$value": "oklch(0.165 0.018 240)" },
      "line": { "$value": "oklch(0.32 0.022 238)" },
      "line-strong": { "$value": "oklch(0.55 0.028 236)" },
