# Overrides applied ONLY inside the `migrate` and `api` containers (see docker-compose.yml and
# docs/ENV_SECRETS_GUIDE.md). backend/.env is written for the host, so its database URLs say
# `localhost` — which, inside a container, is the container itself.
#
# Needed only with the local Postgres service (`docker compose --profile dev up`). With Neon, skip this file:
# the Neon URLs are reachable from anywhere.
#
#   cp .env.docker.example .env.docker

DATABASE_URL=postgres://gridline:gridline@db:5432/gridline
DIRECT_URL=postgres://gridline:gridline@db:5432/gridline

# Containers write uploads to a path that exists inside the image, if STORAGE_DRIVER=local.
# STORAGE_LOCAL_PATH=/tmp/uploads
