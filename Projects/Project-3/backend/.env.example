# Copy to .env. Full detail on where each value comes from lands in
# docs/ENV_SECRETS_GUIDE.md (Milestone 14) — this file documents the graded
# default for every var, with the offline-dev fallback commented beneath it.
#
# NOTE (2026-09, Milestone 1 in progress): @nestjs/config + the Zod
# validation schema that will actually read these don't exist in the app
# yet, and neither does the migration script `migrate` below calls. Compose
# still injects everything here as real container env vars regardless —
# this file is prepared ahead of the code that consumes it, not behind it.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Database (Neon) ---------------------------------------------------------
# Graded/production: Neon's *pooled* connection — what the running app uses.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/gridline?sslmode=require&channel_binding=require
# Graded/production: Neon's *direct* connection — migrations only. PgBouncer's
# transaction-pooling mode breaks some DDL and prepared statements.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/gridline?sslmode=require&channel_binding=require
#
# Local dev instead, via `docker compose --profile dev up` (spins up the `db`
# service below) — point both at it and drop the Neon-only query params:
# DATABASE_URL=postgres://gridline:gridline@db:5432/gridline
# DIRECT_URL=postgres://gridline:gridline@db:5432/gridline

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- Storage ------------------------------------------------------------------
# s3 is the graded default — AWS S3 is a required technology for this
# assignment. `local` is an explicit offline-dev convenience only and must
# never be the configuration a grader runs.
STORAGE_DRIVER=s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./.data/uploads

# --- Mail -----------------------------------------------------------------
# smtp is the graded path; console prints the rendered email instead of
# sending it, so activation/invite links are readable straight from the logs.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Gridline <no-reply@gridline.app>"

# --- AI (data-quality report narrative) ---------------------------------------
# off skips the Gemini call — the deterministic metrics still render.
AI_PROVIDER=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Observability (@nestjs/observe) ------------------------------------------
# Left unset, the SDK no-ops — never required to boot.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# --- Google OAuth --------------------------------------------------------------
# Left unset, password auth still works on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin the browser is redirected back to — the shared Caddy origin
# in Docker (localhost:3000), or localhost:4000 for a bare `npm run start:dev`
# with no proxy in front.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
