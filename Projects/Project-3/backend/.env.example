# Copy to .env. Full detail on where each value comes from lands in
# docs/ENV_SECRETS_GUIDE.md (Milestone 14) — this file documents the graded
# default for every var, with the offline-dev fallback commented beneath it.
#
# Every key here is validated at boot by src/config/env.schema.ts. A missing
# Tier 1 key exits non-zero before the server listens, naming the key. Keys
# left blank (`AWS_REGION=`) are treated as absent, not as empty strings, so a
# freshly copied file boots as-is.
#
# Precedence: real environment variables win over this file, which is what makes
# `docker compose` (env_file -> real container env) and local development (this
# file) both work without conflicting.

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated. Only matters for local non-Docker dev, where the web app on
# :3000 calls the API on :4000 cross-origin. Behind Caddy it's all one origin.
CORS_ORIGIN=http://localhost:3000

# The browser-facing origin, used to build links in emails and (from Phase 5)
# the OAuth redirect target. The shared Caddy origin in Docker.
APP_PUBLIC_URL=http://localhost:3000

# --- Database (Neon) ---------------------------------------------------------
# Graded/production: Neon's *pooled* connection — what the running app uses.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/gridline?sslmode=require&channel_binding=require
# Graded/production: Neon's *direct* connection — migrations only. PgBouncer's
# transaction-pooling mode breaks some DDL and prepared statements.
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/gridline?sslmode=require&channel_binding=require
#
# Local dev instead, via `docker compose --profile dev up` (spins up the `db`
# service below) — point both at it and drop the Neon-only query params:
# DATABASE_URL=postgres://gridline:gridline@db:5432/gridline
# DIRECT_URL=postgres://gridline:gridline@db:5432/gridline

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- Storage ------------------------------------------------------------------
# s3 is the graded default — AWS S3 is a required technology for this
# assignment. `local` is an explicit offline-dev convenience only and must
# never be the configuration a grader runs.
STORAGE_DRIVER=s3
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# STORAGE_DRIVER=local
# STORAGE_LOCAL_PATH=./.data/uploads

# --- Mail -----------------------------------------------------------------
# smtp is the graded path; console prints the rendered email instead of
# sending it, so activation/invite links are readable straight from the logs.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Gridline <no-reply@gridline.app>"

# --- AI (data-quality report narrative) ---------------------------------------
# off skips the Gemini call — the deterministic metrics still render.
AI_PROVIDER=off
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Observability (@nestjs/observe) ------------------------------------------
# BOTH halves must be set for telemetry to be wired at all. The SDK does *not*
# no-op on empty credentials — it starts, flushes, and logs
# `Telemetry rejected (401)` on every flush — so AppModule omits the module
# entirely unless both are present. Left blank, the app runs clean: no
# telemetry, no error noise, no account needed.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Surfaces in Observe's Releases view. Set from the commit SHA at deploy.
GIT_SHA=

# --- Rate limiting & proxies -----------------------------------------------------
# Plan-tiered throttling (Free 30 / Basic 120 / Premium 600 requests a minute per
# company, plus tight per-address limits on sign-in and email-sending routes).
# On unless set to false/0/off. Counters live in process memory (single API instance).
RATE_LIMIT_ENABLED=true
# How many reverse proxies sit in front of the API. 0 for a bare `npm run start:dev`;
# docker-compose sets 1 (Caddy). Too high lets a client spoof its address.
TRUST_PROXY=0

# --- Google OAuth --------------------------------------------------------------
# Left unset, password auth still works on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin the browser is redirected back to — the shared Caddy origin
# in Docker (localhost:3000), or localhost:4000 for a bare `npm run start:dev`
# with no proxy in front.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
